<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    默认使用 nuget.org 官方源。

    离线环境说明：
      若所在网络无法访问 nuget.org，可创建 NuGet.Config.local
      （已在 .gitignore 中忽略，不会提交）覆盖本文件，改用本机包缓存：

        <?xml version="1.0" encoding="utf-8"?>
        <configuration>
          <packageSources>
            <clear />
            <add key="global-cache" value="%USERPROFILE%\.nuget\packages" />
          </packageSources>
        </configuration>

      Windows 全局包目录默认为 %USERPROFILE%\.nuget\packages
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
